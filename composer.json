{
    "name": "sefirosweb/laravel-general-helper",
    "description": "A bundle of helpers for develop, contains method for generate excels , csv, array optimizations and more",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sefirosweb\\LaravelGeneralHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sefirosweb\\LaravelGeneralHelper\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sefirosweb",
            "email": "sefirosweb@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "phpoffice/phpspreadsheet": "^1.28",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sefirosweb\\LaravelGeneralHelper\\LaravelGeneralHelperServiceProvider"
            ]
        }
    }
}
